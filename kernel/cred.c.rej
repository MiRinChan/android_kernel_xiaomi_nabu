--- kernel/cred.c
+++ kernel/cred.c
@@ -195,10 +196,11 @@ const struct cred *get_task_cred(struct task_struct *task)
 
 	rcu_read_lock();
 
-	do {
+	do
+	{
 		cred = __task_cred((task));
 		BUG_ON(!cred);
-	} while (!atomic_long_inc_not_zero(&((struct cred *)cred)->usage));
+	} while (!get_cred_rcu(cred));
 
 	rcu_read_unlock();
 	return cred;
